<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="paperformat_no_margin" model="report.paperformat">
        <field name="name">A4</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">32</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">52</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="True"/>
    </record>

    <record id="account_invoices_without_payment_custom" model="ir.actions.report">
        <field name="name">Invoice PDF Custom</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">invoice_dynamic_attachments.report_invoice_custom</field>
        <field name="report_file">invoice_dynamic_attachments.report_invoice_custom</field>
        <field name="binding_model_id" ref="model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_no_margin"/>
        <field name="domain" eval="[('move_type', '!=', 'entry')]"/>
    </record>

    <template id="invoice_dynamic_attachments.report_invoice_custom">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <main class="page" style="font-size:12px; padding:32px;">

                    <div style="display:flex; justify-content:space-between; margin-bottom:24px;">
                        <div style="width:50%;">
                            <img t-if="o.company_id.logo"
                                 t-att-src="image_data_uri(o.company_id.logo)"
                                 style="max-height:100px; margin-left:20px;"/>
                        </div>

                        <div style="width:100%; text-align:right; padding-right:20px; font-size:14px;">
                            <div>
                                <span t-field="o.company_id.name"/>
                            </div>
                            <div>
                                <span t-field="o.company_id.street"/>
                            </div>
                            <div>
                                <span t-field="o.company_id.zip"/>
                                <span t-field="o.company_id.city"/>
                            </div>
                            <div>
                                <span t-field="o.company_id.country_id.name"/>
                            </div>
                        </div>
                    </div>

                    <div style="display:flex; justify-content:space-between; margin-bottom:24px;">
                        <div style="width:50%; margin-top:20px; font-size:13px;">
                            <div style="margin-bottom:6px; font-size:15px; font-weight:bold;">
                                Invoicing Address:
                            </div>

                            <div style="line-height:1.5;">
                                <span t-field="o.partner_id.name"/>
                                <br/>
                                <span t-field="o.partner_id.street"/>
                                <br/>
                                <span t-field="o.partner_id.city"/>
                            </div>
                        </div>

                        <div style="width:45%; font-size:13px;">
                            <table style="width:100%; border-collapse:collapse;">
                                <tr>
                                    <td>
                                        <strong>Invoice:</strong>
                                    </td>
                                    <td style="text-align:right;">
                                        <span t-field="o.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>Invoice Date:</strong>
                                    </td>
                                    <td style="text-align:right;">
                                        <span t-field="o.invoice_date"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>Due Date:</strong>
                                    </td>
                                    <td style="text-align:right;">
                                        <span t-field="o.invoice_date_due"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>Reference Number:</strong>
                                    </td>
                                    <td style="text-align:right;">
                                        <span t-field="o.ref"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>Payment Terms:</strong>
                                    </td>
                                    <td style="text-align:right;">
                                        <span t-field="o.invoice_payment_term_id.name"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <h1 id="test">Invoice Details</h1>

                    <table style="width:100%; border-collapse:collapse; font-size:15px;">
                        <thead style="background:#f5f7fa; font-size:17px;">
                            <tr>
                                <th style="text-align:left;">Description</th>
                                <th style="text-align:left;">Delivery Date</th>
                                <th style="text-align:right;">Quantity</th>
                                <th style="text-align:right;">Unit</th>
                                <th style="text-align:right;">Price</th>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-foreach="o.invoice_line_ids" t-as="line">

                                <tr>
                                    <td>
                                        <t t-if="line.display_type == 'line_section'">
                                            <div style="font-size:15px; color:#333; font-weight:bold;">
                                                <span t-esc="line.name"/>
                                            </div>
                                            <t t-if="line.attachment_id and line.attachment_number">
                                                <div style="font-size:15px; color:#0d6efd; margin-top:2px;">
                                                    <a t-att-href="'#attachment_%s' % line.attachment_id.id"
                                                       style="text-decoration:none; color:#0d6efd;">
                                                        Attachment
                                                        <span t-esc="line.attachment_number"/>
                                                    </a>
                                                </div>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <div style="font-size:15px;">
                                                [<span t-esc="line.product_id.default_code"/>]
                                                <span t-esc="line.name"/>
                                            </div>
                                            <t t-if="line.attachment_id">
                                                <div style="margin-top:4px;">
                                                    <a t-att-href="'#attachment_%s' % line.attachment_id.id"
                                                       style="text-decoration:none; color:#0d6efd;">
                                                        Attachment
                                                        <span t-esc="line.attachment_number"/>
                                                    </a>
                                                </div>
                                            </t>
                                        </t>
                                    </td>

                                    <td>
                                        <t t-if="not line.display_type">
                                            <span t-field="line.delivery_date"/>
                                        </t>
                                    </td>

                                    <td style="text-align:right;">
                                        <t t-if="not line.display_type">
                                            <span t-esc="line.quantity"/>
                                        </t>
                                    </td>

                                    <td style="text-align:right;">
                                        <t t-if="not line.display_type">
                                            <span t-esc="line.uom_id.name"/>
                                        </t>
                                    </td>

                                    <td style="text-align:right;">
                                        <t t-if="not line.display_type">
                                            <span t-esc="line.price_unit"/>
                                            €
                                        </t>
                                    </td>
                                </tr>

                            </t>
                        </tbody>
                    </table>
                    <t t-foreach="o.invoice_line_ids.filtered(lambda l: l.attachment_id)" t-as="line">
                        <div style="page-break-before:always; position:relative; width:100%; min-height:240mm;">
                            <div t-att-id="'attachment_%s' % line.attachment_id.id"
                                 style="
                position:absolute;
                top:10%;
                left:32%;
                transform:translate(-50%, -50%);
                text-align:center;
                font-size:20px;
                font-weight:bold;
             ">
                                This is dummy attachment
                                <span t-esc="line.attachment_number"/>
                            </div>
                        </div>
                    </t>


                </main>
            </t>
        </t>
    </template>


</odoo>
